---
import Base from './Base.astro';

export interface Props {
  title: string;
  description: string;
  pubDate: string;
  pillar: string;
  readTime: string;
  heroImage?: string;
}

const { title, description, pubDate, pillar, readTime, heroImage } = Astro.props;
---

<Base title={`${title} — Intentional Thrive`} description={description}>

  <main>
    <!-- Article Header -->
    <header class="article-header">
      <div class="container">
        <span class="card__tag">{pillar}</span>
        <h1 class="article-header__title">{title}</h1>
        <p class="article-header__desc">{description}</p>
        <div class="article-header__meta">
          <span>{pubDate}</span>
          <span class="article-header__dot">·</span>
          <span>{readTime} read</span>
        </div>
      </div>
    </header>

    {heroImage && (
      <div class="hero-image-wrap">
        <img src={heroImage} alt={title} class="hero-image" />
      </div>
    )}

    <!-- Article Body -->
    <article class="container">
      <div class="prose article-body">
        <slot />
      </div>

      <hr class="divider" />

      <!-- Author bio -->
      <div class="author-card">
        <div class="author-card__avatar">V</div>
        <div>
          <div class="author-card__name">Venus</div>
          <div class="author-card__bio">Pru Life UK Unit Manager · Founder, Intentional Thrive · Writing about money mindset, wealth planning, and intentional living for Filipino professionals.</div>
          <a href="/about" class="author-card__link">More about Venus &rarr;</a>
        </div>
      </div>

      <!-- CTA -->
      <div class="article-cta-grid">
        <div class="article-cta article-cta--light">
          <span class="article-cta__label">For your next decision</span>
          <h3>Apply this to your real financial picture.</h3>
          <p>Get a free readiness assessment to review your cash flow, protection gaps, existing coverage, and next best move.</p>
          <a href="/assessment" class="btn btn--primary">Get free assessment</a>
        </div>
        <div class="article-cta article-cta--dark">
          <span class="article-cta__label">For your career</span>
          <h3>Curious about becoming an advisor?</h3>
          <p>Explore Venus's leadership approach and the kind of mentorship behind Intentional Thrive.</p>
          <a href="/join-the-team" class="btn btn--dark">Join the team</a>
        </div>
      </div>
    </article>
  </main>

</Base>

<style>
.article-header {
  background: linear-gradient(135deg, #edf5ef 0%, #ffffff 100%);
  padding: 4rem 0 3rem;
  margin-bottom: 3rem;
}

.article-header__title {
  font-size: clamp(1.75rem, 4vw, 2.75rem);
  margin: 0.75rem 0;
  max-width: 680px;
}

.article-header__desc {
  font-size: 1.1rem;
  color: var(--color-text-muted);
  max-width: 600px;
  margin-bottom: 1.25rem;
}

.article-header__meta {
  font-size: 0.85rem;
  color: var(--color-text-muted);
}

.article-header__dot {
  margin: 0 0.5rem;
}

.hero-image-wrap {
  max-width: 780px;
  margin: 0 auto 3rem;
  padding: 0 1.5rem;
}

.hero-image {
  width: 100%;
  height: auto;
  max-height: 480px;
  object-fit: cover;
  border-radius: 12px;
  display: block;
}

.article-body {
  padding-bottom: 2rem;
}

.author-card {
  display: flex;
  gap: 1.25rem;
  align-items: flex-start;
  background: var(--color-bg-alt);
  border-radius: 8px;
  padding: 1.5rem;
  margin-bottom: 2.5rem;
}

.author-card__avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: var(--color-accent);
  color: white;
  font-family: var(--font-serif);
  font-size: 1.25rem;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.author-card__name {
  font-weight: 600;
  color: var(--color-heading);
  margin-bottom: 0.3rem;
}

.author-card__bio {
  font-size: 0.875rem;
  color: var(--color-text-muted);
  line-height: 1.6;
  margin-bottom: 0.5rem;
}

.author-card__link {
  font-size: 0.875rem;
  font-weight: 500;
}

.article-cta-grid {
  display: grid;
  gap: 1rem;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-bottom: 3rem;
}

.article-cta {
  border-radius: 8px;
  padding: 2rem;
}

.article-cta--light {
  background: var(--color-bg-alt);
  border: 1px solid var(--color-border);
}

.article-cta--dark {
  background: var(--color-heading);
  border: 1px solid rgba(214, 189, 120, 0.26);
  color: #c8d4cb;
}

.article-cta--dark h3 {
  color: #ffffff;
}

.article-cta p {
  margin-bottom: 1.5rem;
  font-size: 0.95rem;
}

.article-cta__label {
  color: var(--color-accent);
  display: block;
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  margin-bottom: 0.7rem;
  text-transform: uppercase;
}

.article-cta--dark .article-cta__label {
  color: var(--color-gold);
}

.article-cta h3 {
  font-family: var(--font-sans);
  font-size: 1.12rem;
  margin-bottom: 0.75rem;
}

@media (max-width: 720px) {
  .article-cta-grid {
    grid-template-columns: 1fr;
  }
}
</style>
