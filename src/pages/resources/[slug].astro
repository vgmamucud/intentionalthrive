---
import Base from '../../layouts/Base.astro';
import { resourceGuides } from '../../data/resourceGuides';

export function getStaticPaths() {
  return resourceGuides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

const { guide } = Astro.props;
---

<Base
  title={`${guide.title} - Intentional Thrive`}
  description={guide.description}
>
  <header class="resource-hero">
    <div class="container--wide resource-hero__grid">
      <div>
        <span class="section-kicker">{guide.eyebrow}</span>
        <h1>{guide.title}</h1>
        <p>{guide.intro}</p>
        <div class="authority-actions">
          <button type="button" class="btn btn--primary" onclick="window.print()">Print or save PDF</button>
          <a href="/assessment" class="btn btn--outline">Use this with Venus</a>
        </div>
      </div>
      <aside class="resource-summary">
        <span>Intentional Thrive Resource</span>
        <strong>Use it before the conversation.</strong>
        <p>{guide.description}</p>
      </aside>
    </div>
  </header>

  <main class="resource-page">
    <section class="container--wide">
      <div class="resource-grid">
        {guide.sections.map((section) => (
          <article class="resource-card">
            <h2>{section.title}</h2>
            <ul>
              {section.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="container--wide resource-prompts-wrap">
      <div class="resource-prompts">
        <div>
          <span class="section-kicker">Reflection Prompts</span>
          <h2>Write these down before you ask for advice.</h2>
        </div>
        <ol>
          {guide.prompts.map((prompt) => (
            <li>{prompt}</li>
          ))}
        </ol>
      </div>
    </section>

    <section class="cta-band resource-cta">
      <div class="container">
        <span class="section-kicker">Next Step</span>
        <h2>Turn the guide into a clearer decision.</h2>
        <p>{guide.nextStep}</p>
        <div class="btn-row btn-row--center">
          <a href="/assessment" class="btn-white">Request assessment</a>
          <a href="mailto:venus@intentionalthrive.com?subject=Resource%20Question" class="btn-white btn-white--ghost">Ask Venus a question</a>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
.resource-hero {
  background:
    linear-gradient(135deg, rgba(24, 48, 40, 0.9), rgba(16, 27, 23, 0.82)),
    url('/images/intentional-thrive-planning.png');
  background-position: center;
  background-size: cover;
  color: #ffffff;
  padding: 5.5rem 0 4.8rem;
}

.resource-hero h1 {
  color: #ffffff;
  font-size: clamp(2.5rem, 6vw, 5rem);
  letter-spacing: 0;
  max-width: 820px;
}

.resource-hero p {
  color: rgba(255, 255, 255, 0.84);
  font-size: 1.05rem;
  line-height: 1.75;
  margin: 1.3rem 0 2rem;
  max-width: 680px;
}

.resource-hero .btn--outline {
  border-color: rgba(255, 255, 255, 0.34);
  color: #ffffff;
}

.resource-hero .btn--outline:hover {
  background: #ffffff;
  border-color: #ffffff;
  color: var(--color-dark);
}

.resource-hero__grid {
  align-items: end;
  display: grid;
  gap: 2rem;
  grid-template-columns: minmax(0, 1fr) 320px;
}

.resource-summary {
  background: rgba(255, 255, 255, 0.96);
  border: 1px solid rgba(255, 255, 255, 0.76);
  border-radius: 8px;
  box-shadow: 0 24px 70px rgba(0, 0, 0, 0.24);
  color: var(--color-dark);
  padding: 1.4rem;
}

.resource-summary span {
  color: var(--color-accent);
  display: block;
  font-size: 0.72rem;
  font-weight: 900;
  letter-spacing: 0.08em;
  margin-bottom: 0.5rem;
  text-transform: uppercase;
}

.resource-summary strong {
  display: block;
  font-size: 1.15rem;
  line-height: 1.3;
}

.resource-summary p {
  color: var(--color-text-muted);
  font-size: 0.9rem;
  line-height: 1.6;
  margin: 0.75rem 0 0;
}

.resource-page {
  background: #ffffff;
}

.resource-grid {
  display: grid;
  gap: 1rem;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  padding: 4rem 0;
}

.resource-card {
  background: linear-gradient(180deg, #ffffff 0%, var(--color-bg) 100%);
  border: 1px solid var(--color-border);
  border-radius: 8px;
  padding: 1.6rem;
}

.resource-card h2,
.resource-prompts h2 {
  font-family: var(--font-sans);
  font-size: 1.08rem;
  margin-bottom: 1rem;
}

.resource-card ul,
.resource-prompts ol {
  display: grid;
  gap: 0.8rem;
  list-style: none;
}

.resource-card li {
  color: var(--color-text-muted);
  line-height: 1.6;
  padding-left: 1.8rem;
  position: relative;
}

.resource-card li::before {
  border: 2px solid var(--color-accent);
  border-radius: 4px;
  content: "";
  height: 16px;
  left: 0;
  position: absolute;
  top: 0.32rem;
  width: 16px;
}

.resource-prompts-wrap {
  padding-bottom: 4rem;
}

.resource-prompts {
  background: var(--color-bg-alt);
  border: 1px solid var(--color-border);
  border-radius: 8px;
  display: grid;
  gap: 2rem;
  grid-template-columns: 0.8fr 1.2fr;
  padding: 2rem;
}

.resource-prompts li {
  background: #ffffff;
  border: 1px solid var(--color-border);
  border-radius: 8px;
  color: var(--color-heading);
  font-weight: 700;
  line-height: 1.5;
  padding: 1rem;
}

.resource-cta {
  margin-top: 0;
}

.btn-white--ghost {
  background: rgba(255, 255, 255, 0.14);
  border: 1px solid rgba(255, 255, 255, 0.34);
  color: #ffffff;
}

.btn-white--ghost:hover {
  background: #ffffff;
  color: var(--color-accent);
}

@media (max-width: 820px) {
  .resource-hero__grid,
  .resource-grid,
  .resource-prompts {
    grid-template-columns: 1fr;
  }
}

@media print {
  .nav,
  .footer,
  .authority-actions,
  .resource-cta {
    display: none !important;
  }

  .resource-hero {
    background: #ffffff;
    color: #111111;
    padding: 1rem 0 0.5rem;
  }

  .resource-hero h1,
  .resource-hero p {
    color: #111111;
  }

  .resource-summary,
  .resource-card,
  .resource-prompts li {
    box-shadow: none;
  }
}
</style>
