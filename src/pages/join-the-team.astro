---
import Base from '../layouts/Base.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Join the Team - Intentional Thrive',
  description: 'A career pathway for future financial advisors who want mentorship, service, and meaningful income growth with Venus.',
};
---

<Base
  title="Join the Team - Intentional Thrive"
  description="Explore a financial services career with Venus: mentorship, client education, leadership, and meaningful work built on clarity."
  schema={schema}
>
  <header class="authority-hero" id="career">
    <div class="container--wide">
      <span class="section-kicker">Future Advisors</span>
      <h1>Build a career around clarity, service, and leadership.</h1>
      <p class="authority-hero__copy">For people who want meaningful work, income growth, and mentorship from someone who has built in the middle of real life: clients, team, marriage, motherhood, and ambition.</p>
      <div class="authority-actions">
        <a href="mailto:venus@intentionalthrive.com?subject=Career%20Conversation" class="btn btn--primary">Start a career conversation</a>
        <a href="/blog/first-year-leading-taught-me-about-money" class="btn btn--outline">Read the leadership story</a>
      </div>
    </div>
  </header>

  <section class="section-block section-block--white">
    <div class="container--wide">
      <span class="section-kicker">Who This Is For</span>
      <h2>This path is for people who care about more than selling.</h2>
      <p class="section-intro">The best advisors learn how to listen, educate, follow through, and help people make decisions they understand. That is the standard here.</p>

      <div class="hub-grid">
        <article class="hub-card">
          <span class="hub-card__label">Career Builders</span>
          <h3>You want flexible, meaningful income growth</h3>
          <p>You are willing to learn a serious profession and build with consistency, not only chase short-term wins.</p>
        </article>
        <article class="hub-card">
          <span class="hub-card__label">Educators</span>
          <h3>You can explain without overwhelming people</h3>
          <p>You believe financial advice should make clients feel more capable, not smaller or more confused.</p>
        </article>
        <article class="hub-card">
          <span class="hub-card__label">Leaders</span>
          <h3>You want mentorship and accountability</h3>
          <p>You want a team environment where growth is practical, honest, and rooted in service.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section-block">
    <div class="container">
      <span class="section-kicker">Mentorship Path</span>
      <h2>What Venus helps future advisors build.</h2>
      <div class="step-list">
        <article>
          <h3>Client-first language</h3>
          <p>Learn how to explain protection, insurance, planning, and long-term decisions in a way real people can understand.</p>
        </article>
        <article>
          <h3>Personal financial clarity</h3>
          <p>You cannot guide others well while ignoring your own money story, habits, and protection plan.</p>
        </article>
        <article>
          <h3>A sustainable working rhythm</h3>
          <p>Build routines for prospecting, follow-ups, client care, learning, and leadership without pretending life is perfectly tidy.</p>
        </article>
        <article>
          <h3>Professional trust</h3>
          <p>Grow a reputation through education, consistency, and follow-through rather than pressure or image alone.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section-block section-block--white">
    <div class="container--wide">
      <div class="hub-grid hub-grid--two">
        <a href="/blog/first-year-leading-taught-me-about-money" class="hub-card">
          <span class="hub-card__label">Read First</span>
          <h3>What my first year of leading taught me about money</h3>
          <p>A grounded look at leadership, income security, and what it means to guide a team in financial services.</p>
        </a>
        <a href="/blog/building-in-public" class="hub-card">
          <span class="hub-card__label">Brand Philosophy</span>
          <h3>Why I am building this in public</h3>
          <p>The visibility philosophy behind Intentional Thrive and why transparency matters in Philippine financial services.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container">
      <span class="section-kicker">Take The First Step</span>
      <h2>Curious if this career fits you?</h2>
      <p>Start with a conversation about your goals, questions, and current season of life.</p>
      <a href="mailto:venus@intentionalthrive.com?subject=Career%20Conversation" class="btn-white">Start a career conversation</a>
    </div>
  </section>
</Base>
