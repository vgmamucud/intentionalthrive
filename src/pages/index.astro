---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import ThrivePath from '../components/ThrivePath.astro';

const homepageEntry = await getEntry('homepage', 'main');
if (!homepageEntry) {
  throw new Error('Missing homepage content: src/content/homepage/main.json');
}

const homepage = homepageEntry.data;
const recentArticles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 3);
---

<Base
  title={homepage.seo.title}
  description={homepage.seo.description}
>

  <section class="hero-slider" data-hero aria-roledescription="carousel" aria-label="Intentional Thrive highlights">
    {homepage.heroSlides.map((slide, index) => (
      <article
        class:list={['hero-slide', index === 0 && 'is-active']}
        data-hero-slide
        aria-hidden={index === 0 ? 'false' : 'true'}
        style={`background-image: ${slide.tint}, url('${slide.image}'); background-position: ${slide.focal}; background-size: ${slide.zoom}`}
      >
        <div class="container--wide hero-slide__inner">
          <p class="hero-slide__quote">&ldquo;{slide.quote}&rdquo;</p>
          <p class="hero-slide__tagline">{slide.tagline}</p>
          <p class="hero-slide__copy">{slide.copy}</p>
          <a href={slide.href} class="hero-slide__cta">{slide.cta}</a>
        </div>
      </article>
    ))}

    <div class="hero-slider__controls">
      <button type="button" data-hero-prev aria-label="Previous slide"><i class="ti ti-chevron-left" aria-hidden="true"></i></button>
      <button type="button" data-hero-next aria-label="Next slide"><i class="ti ti-chevron-right" aria-hidden="true"></i></button>
    </div>
  </section>

  <section class="quicklinks" aria-label="Quick links">
    <div class="container--wide quicklinks__inner">
      <div class="quicklinks__main">
        <p class="quicklinks__label">I am looking to&hellip;</p>
        <div class="quicklinks__track" data-quick-track>
          {homepage.quickLinks.map((link) => (
            <a href={link.href} class="quicklinks__item">
              <i class={`ti ${link.icon}`} aria-hidden="true"></i>
              <span>{link.label}</span>
            </a>
          ))}
        </div>
        <div class="quicklinks__controls">
          <button type="button" data-quick-prev aria-label="Scroll quick links left"><i class="ti ti-chevron-left" aria-hidden="true"></i></button>
          <button type="button" data-quick-next aria-label="Scroll quick links right"><i class="ti ti-chevron-right" aria-hidden="true"></i></button>
        </div>
      </div>

      <aside class="quicklinks__aside">
        <p>{homepage.quickAside.text}</p>
        <a href={homepage.quickAside.href}><i class="ti ti-send" aria-hidden="true"></i> {homepage.quickAside.cta}</a>
      </aside>
    </div>
  </section>

  <section class="help-tabs">
    <div class="container--wide">
      <h2 class="help-tabs__title">{homepage.helpTitle} <strong>{homepage.helpTitleAccent}</strong></h2>

      <div class="help-tabs__nav" role="tablist">
        {homepage.helpTabs.map((tab, index) => (
          <button
            type="button"
            role="tab"
            id={`tab-${tab.id}`}
            aria-controls={`panel-${tab.id}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            class:list={['help-tabs__tab', index === 0 && 'is-active']}
            data-tab={tab.id}
          >
            {tab.label}
          </button>
        ))}
      </div>

      {homepage.helpTabs.map((tab, index) => (
        <div
          class:list={['help-tabs__panel', index === 0 && 'is-active']}
          id={`panel-${tab.id}`}
          role="tabpanel"
          aria-labelledby={`tab-${tab.id}`}
          data-panel={tab.id}
          hidden={index !== 0}
        >
          {tab.cards.map((card) => (
            <a href={card.href} class="help-card">
              <h3>{card.title}</h3>
              <p>{card.copy}</p>
              <span>Learn more <i class="ti ti-arrow-right" aria-hidden="true"></i></span>
            </a>
          ))}
        </div>
      ))}
    </div>
  </section>

  <section class="proof-band">
    <div class="container--wide proof-grid">
      {homepage.proofStats.map((stat) => (
        <div><strong>{stat.value}</strong><span>{stat.label}</span></div>
      ))}
    </div>
  </section>

  <section class="pathway-section">
    <div class="container--wide">
      <div class="section-heading compact">
        <p class="eyebrow">{homepage.pathways.eyebrow}</p>
        <h2>{homepage.pathways.heading}</h2>
        <p>{homepage.pathways.copy}</p>
        <ThrivePath variant="rule" />
      </div>

      <div class="door-grid">
        {homepage.pathways.doors.map((door) => (
          <a href={door.href} class="door">
            <span class="door__label">{door.label}</span>
            <h3>{door.heading}</h3>
            <p>{door.copy}</p>
            <span class="door__link">{door.linkLabel} &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="journey" id="clarity-map">
    <div class="container--wide">
      <div class="section-heading">
        <p class="eyebrow">{homepage.journey.eyebrow}</p>
        <h2>{homepage.journey.heading}</h2>
        <p>{homepage.journey.copy}</p>
        <ThrivePath variant="rule" />
      </div>

      <div class="journey__path"><ThrivePath variant="journey" /></div>

      <div class="journey-grid">
        {homepage.journey.steps.map((step) => (
          <article>
            <span class="journey__step">{step.label}</span>
            <h3>{step.heading}</h3>
            <p>{step.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="decision-section" id="career">
    <div class="container--wide decision-grid">
      {homepage.decisionCards.map((card) => (
        <div class:list={['decision-card', card.theme]}>
          <p class="eyebrow">{card.eyebrow}</p>
          <h2>{card.heading}</h2>
          <p>{card.copy}</p>
          <a href={card.href} class:list={['btn', card.theme === 'dark' ? 'btn--dark' : 'btn--primary']}>{card.cta}</a>
        </div>
      ))}
    </div>
  </section>

  <section class="guide-section">
    <div class="container--wide guide-grid">
      <div>
        <p class="eyebrow">{homepage.guide.eyebrow}</p>
        <h2>{homepage.guide.heading}</h2>
      </div>
      <div class="guide-copy">
        {homepage.guide.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        <a href={homepage.guide.href} class="text-link">{homepage.guide.cta} &rarr;</a>
      </div>
    </div>
  </section>

  <section class="article-strip">
    <div class="container--wide">
      <div class="section-heading compact">
        <p class="eyebrow">{homepage.articleStrip.eyebrow}</p>
        <h2>{homepage.articleStrip.heading}</h2>
        <p>{homepage.articleStrip.copy}</p>
        <ThrivePath variant="rule" />
      </div>
      <div class="article-grid">
        {recentArticles.map(article => (
          <a href={`/blog/${article.slug}`} class="article-card">
            <span>{article.data.pillar}</span>
            <h3>{article.data.title}</h3>
            <p>{article.data.description}</p>
          </a>
        ))}
      </div>
      <div class="btn-row btn-row--center article-strip-actions">
        <a href={homepage.articleStrip.primaryHref} class="btn btn--primary">{homepage.articleStrip.primaryCta}</a>
        <a href={homepage.articleStrip.secondaryHref} class="btn btn--outline">{homepage.articleStrip.secondaryCta}</a>
      </div>
    </div>
  </section>

  <section class="final-banner">
    <div class="final-banner__mark" aria-hidden="true"><ThrivePath variant="mark" /></div>
    <div class="container">
      <p class="eyebrow">{homepage.finalCta.eyebrow}</p>
      <h2>{homepage.finalCta.heading}</h2>
      <a href={homepage.finalCta.href} class="btn-white">{homepage.finalCta.cta}</a>
    </div>
  </section>

</Base>

<script>
  // Hero carousel
  const hero = document.querySelector('[data-hero]');
  const slides = Array.from(document.querySelectorAll('[data-hero-slide]'));
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (hero && slides.length > 1) {
    let index = 0;
    let timer;

    const show = (next) => {
      index = (next + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        slide.classList.toggle('is-active', i === index);
        slide.setAttribute('aria-hidden', i === index ? 'false' : 'true');
      });
    };

    const start = () => {
      if (reduceMotion) return;
      stop();
      timer = window.setInterval(() => show(index + 1), 7000);
    };
    const stop = () => window.clearInterval(timer);

    document.querySelector('[data-hero-prev]')?.addEventListener('click', () => { show(index - 1); start(); });
    document.querySelector('[data-hero-next]')?.addEventListener('click', () => { show(index + 1); start(); });
    hero.addEventListener('mouseenter', stop);
    hero.addEventListener('mouseleave', start);
    start();
  }

  // Quick links horizontal scroll
  const track = document.querySelector('[data-quick-track]');
  if (track) {
    const step = () => Math.max(track.clientWidth * 0.6, 200);
    document.querySelector('[data-quick-prev]')?.addEventListener('click', () =>
      track.scrollBy({ left: -step(), behavior: 'smooth' })
    );
    document.querySelector('[data-quick-next]')?.addEventListener('click', () =>
      track.scrollBy({ left: step(), behavior: 'smooth' })
    );
  }

  // Help tabs
  const tabs = Array.from(document.querySelectorAll('[data-tab]'));
  const panels = Array.from(document.querySelectorAll('[data-panel]'));

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const id = tab.getAttribute('data-tab');
      tabs.forEach((other) => {
        const active = other === tab;
        other.classList.toggle('is-active', active);
        other.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      panels.forEach((panel) => {
        const active = panel.getAttribute('data-panel') === id;
        panel.classList.toggle('is-active', active);
        panel.hidden = !active;
      });
    });
  });
</script>

<style>
/* Hero carousel */
.hero-slider {
  display: grid;
  isolation: isolate;
  min-height: clamp(460px, 62vh, 660px);
  overflow: hidden;
  position: relative;
}

.hero-slide {
  align-items: end;
  background-repeat: no-repeat;
  color: #fff;
  display: grid;
  grid-area: 1 / 1;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.9s ease;
}

.hero-slide.is-active {
  opacity: 1;
  pointer-events: auto;
}

.hero-slide__inner {
  max-width: var(--max-width-wide);
  padding-bottom: 210px;
  text-align: center;
}

.hero-slide.is-active .hero-slide__inner > * {
  animation: heroReveal 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
}

.hero-slide.is-active .hero-slide__tagline { animation-delay: 0.1s; }
.hero-slide.is-active .hero-slide__copy { animation-delay: 0.2s; }
.hero-slide.is-active .hero-slide__cta { animation-delay: 0.3s; }

.hero-slide__quote {
  color: #fff;
  font-family: var(--font-sans);
  font-size: clamp(36px, 5.4vw, 68px);
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.06;
  margin: 0 auto;
  max-width: 900px;
}

.hero-slide__tagline {
  color: rgba(255, 255, 255, 0.92);
  font-size: clamp(18px, 2.4vw, 26px);
  font-weight: 600;
  margin: 18px 0 0;
}

.hero-slide__copy {
  color: rgba(255, 255, 255, 0.82);
  font-size: 17px;
  line-height: 1.7;
  margin: 16px auto 0;
  max-width: 620px;
}

.hero-slide__cta {
  background: var(--color-accent);
  border-radius: var(--radius);
  color: #fff;
  display: inline-block;
  font-size: 15px;
  font-weight: 600;
  margin-top: 28px;
  padding: 15px 34px;
  transition: background 0.35s ease;
}

.hero-slide__cta:hover {
  background: #3f6f50;
  color: #fff;
}

.hero-slider__controls {
  bottom: 130px;
  display: flex;
  gap: 12px;
  justify-content: center;
  left: 0;
  position: absolute;
  right: 0;
  z-index: 4;
}

.hero-slider__controls button {
  align-items: center;
  background: rgba(255, 255, 255, 0.14);
  border: 1px solid rgba(255, 255, 255, 0.7);
  border-radius: 999px;
  color: #fff;
  cursor: pointer;
  display: inline-flex;
  font-size: 18px;
  height: 42px;
  justify-content: center;
  transition: background 0.2s ease, color 0.2s ease;
  width: 42px;
}

.hero-slider__controls button:hover {
  background: #fff;
  color: var(--color-dark);
}

/* Quick links bar (overlaps the hero) */
.quicklinks {
  margin-top: -84px;
  position: relative;
  z-index: 5;
}

.quicklinks__inner {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 300px;
  min-width: 0;
}

.quicklinks__main {
  align-items: center;
  background: var(--color-accent);
  border-radius: var(--radius-lg) 0 0 var(--radius-lg);
  color: #fff;
  display: flex;
  gap: 20px;
  min-width: 0;
  padding: 26px;
}

.quicklinks__label {
  color: #fff;
  flex-shrink: 0;
  font-size: 20px;
  font-weight: 800;
  letter-spacing: -0.02em;
  margin: 0;
  max-width: 150px;
}

.quicklinks__track {
  display: flex;
  flex: 1;
  gap: 14px;
  min-width: 0;
  overflow-x: auto;
  scroll-behavior: smooth;
  scrollbar-width: none;
}

.quicklinks__track::-webkit-scrollbar {
  display: none;
}

.quicklinks__item {
  color: #fff;
  display: grid;
  flex: 0 0 auto;
  font-size: 13px;
  font-weight: 600;
  gap: 8px;
  justify-items: center;
  line-height: 1.3;
  text-align: center;
  transition: opacity 0.35s ease;
  width: 96px;
}

.quicklinks__item i {
  font-size: 30px;
}

.quicklinks__item:hover {
  color: #fff;
  opacity: 0.78;
}

.quicklinks__controls {
  display: flex;
  flex-shrink: 0;
  gap: 10px;
}

.quicklinks__controls button {
  align-items: center;
  background: rgba(255, 255, 255, 0.22);
  border: none;
  border-radius: 999px;
  color: #fff;
  cursor: pointer;
  display: inline-flex;
  font-size: 18px;
  height: 40px;
  justify-content: center;
  transition: background 0.2s ease, color 0.2s ease;
  width: 40px;
}

.quicklinks__controls button:hover {
  background: #fff;
  color: var(--color-accent);
}

.quicklinks__aside {
  background: var(--color-dark);
  border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
  color: #fff;
  display: grid;
  align-content: center;
  gap: 14px;
  padding: 26px 30px;
}

.quicklinks__aside p {
  color: #fff;
  font-size: 16px;
  font-weight: 700;
  margin: 0;
}

.quicklinks__aside a {
  align-items: center;
  background: var(--color-accent-pale);
  border-radius: var(--radius);
  color: var(--color-dark);
  display: inline-flex;
  font-size: 14px;
  font-weight: 600;
  gap: 8px;
  justify-content: center;
  padding: 13px 20px;
  transition: background 0.2s ease, color 0.2s ease;
}

.quicklinks__aside a:hover {
  background: #fff;
  color: var(--color-accent);
}

/* How can we help — tabs */
.help-tabs {
  background: #fff;
  padding: 76px 0 88px;
}

.help-tabs__title {
  font-size: clamp(30px, 4vw, 46px);
  font-weight: 300;
  letter-spacing: -0.025em;
  margin-bottom: 26px;
}

.help-tabs__title strong {
  font-weight: 700;
}

.help-tabs__nav {
  border-bottom: 1px solid var(--color-border);
  display: flex;
  gap: 30px;
  margin-bottom: 34px;
}

.help-tabs__tab {
  background: none;
  border: none;
  border-bottom: 3px solid transparent;
  color: var(--color-text-muted);
  cursor: pointer;
  font-family: var(--font-sans);
  font-size: 16px;
  font-weight: 600;
  margin-bottom: -1px;
  padding: 0 2px 14px;
  transition: color 0.35s ease, border-color 0.35s ease;
}

.help-tabs__tab.is-active {
  border-bottom-color: var(--color-accent);
  color: var(--color-accent);
}

.help-tabs__panel {
  display: none;
  gap: 40px;
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.help-tabs__panel.is-active {
  display: grid;
}

.help-card {
  border-top: 1px solid var(--color-border);
  color: inherit;
  display: flex;
  flex-direction: column;
  padding-top: 22px;
  transition: border-color 0.35s ease;
}

.help-card:hover {
  border-top-color: var(--color-accent);
  color: inherit;
}

.help-card h3 {
  font-size: 20px;
  font-weight: 700;
  letter-spacing: -0.02em;
  margin-bottom: 10px;
}

.help-card p {
  color: var(--color-text-muted);
  font-size: 14px;
  line-height: 1.65;
  margin-bottom: 16px;
}

.help-card span {
  color: var(--color-accent);
  font-size: 13px;
  font-weight: 600;
  margin-top: auto;
}

.proof-band {
  background: linear-gradient(180deg, #ffffff 0%, #f7faf8 100%);
  border-bottom: 1px solid var(--color-border);
  padding: 28px 0;
}

.proof-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

.proof-grid div {
  border-left: 3px solid rgba(214, 189, 120, 0.72);
  padding-left: 16px;
}

.proof-grid strong {
  color: var(--color-dark);
  display: block;
  font-size: 28px;
  font-weight: 700;
  letter-spacing: -0.025em;
}

.proof-grid span {
  color: var(--color-text-muted);
  font-size: 13px;
}

.journey,
.decision-section,
.guide-section,
.pathway-section,
.article-strip {
  padding: 104px 0;
}

.journey,
.guide-section {
  background: var(--color-bg);
}

.section-heading {
  margin: 0 auto 46px;
  max-width: 720px;
  position: relative;
  text-align: center;
}

.section-heading.compact {
  max-width: 650px;
}

.section-heading h2,
.decision-card h2,
.guide-grid h2,
.final-banner h2 {
  font-size: clamp(32px, 4.6vw, 54px);
  letter-spacing: -0.028em;
  line-height: 1.1;
}

.section-heading p:not(.eyebrow) {
  color: var(--color-text-muted);
  font-size: 17px;
  line-height: 1.7;
  margin-top: 18px;
}

.journey__path {
  margin-bottom: -18px;
}

.journey-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 40px;
}

.journey-grid article {
  border-top: 1px solid var(--color-border);
  padding-top: 22px;
}

.journey__step {
  color: var(--color-accent);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.journey-grid h3,
.article-card h3 {
  color: var(--color-dark);
  font-size: 24px;
  font-weight: 700;
  letter-spacing: -0.025em;
  margin: 12px 0 10px;
}

.journey-grid p,
.decision-card p,
.guide-copy p,
.article-card p {
  color: var(--color-text-muted);
  line-height: 1.75;
}

.decision-section {
  background: #fff;
}

.pathway-section {
  background: #fff;
}

.door-grid {
  display: grid;
  gap: 44px;
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.door {
  border-top: 2px solid var(--color-accent);
  color: inherit;
  display: block;
  padding-top: 22px;
}

.door__label {
  color: var(--color-accent);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.door h3 {
  font-size: 24px;
  font-weight: 700;
  letter-spacing: -0.025em;
  margin: 12px 0 10px;
}

.door p {
  color: var(--color-text-muted);
  font-size: 16px;
  line-height: 1.75;
  margin-bottom: 14px;
}

.door__link {
  color: var(--color-accent);
  font-size: 14px;
  font-weight: 600;
}

.decision-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22px;
}

.decision-card {
  border-radius: var(--radius-lg);
  padding: 42px;
}

.decision-card.primary {
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.72), rgba(237, 245, 239, 0.94)),
    var(--color-accent-pale);
  border: 1px solid rgba(79, 129, 95, 0.24);
}

.decision-card.dark {
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.08), transparent 46%),
    var(--color-dark);
  border: 1px solid rgba(214, 189, 120, 0.2);
}

.decision-card.dark h2,
.decision-card.dark p {
  color: #fff;
}

.decision-card p {
  font-size: 17px;
  margin: 18px 0 28px;
}

.btn--dark {
  background: #fff;
  color: var(--color-dark);
}

.btn--dark:hover {
  background: var(--color-accent);
  color: #fff;
}

.guide-grid {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: 58px;
  align-items: start;
}

.guide-copy {
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 34px;
}

.text-link {
  color: var(--color-accent);
  display: inline-block;
  font-weight: 600;
  margin-top: 10px;
}

.article-strip {
  background: #fff;
}

.article-strip-actions {
  margin-top: 32px;
}

.article-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.article-grid {
  gap: 44px;
