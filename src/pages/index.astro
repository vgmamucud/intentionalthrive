---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ThrivePath from '../components/ThrivePath.astro';

const recentArticles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 3);

// Hero carousel. Each slide: its own photo (public/images/hero-*.png), a focal point
// biased toward the top so faces stay clear of the text sitting near the bottom, and a
// tint tuned for white overlay text against that specific photo.
const heroSlides = [
  {
    quote: 'I will help you get ahead.',
    tagline: 'Clarity, made practical',
    copy: 'For Filipino professionals who are earning, leading, parenting, and quietly wondering if their money is finally working in the right direction.',
    cta: 'Learn more',
    href: '/start-here',
    image: '/images/hero-understand.jpg',
    focal: '62% 32%',
    zoom: 'cover',
    tint: 'linear-gradient(135deg, rgba(24, 48, 40, 0.66), rgba(16, 27, 23, 0.6))',
  },
  {
    quote: 'I will protect what you built.',
    tagline: 'Protection, understood',
    copy: 'Know what your coverage actually does before you buy anything new, and what happens to your family if income stops.',
    cta: 'Review your coverage',
    href: '/resources/life-insurance-review-guide',
    image: '/images/hero-decide.jpg',
    focal: '50% 15%',
    zoom: 'cover',
    tint: 'linear-gradient(135deg, rgba(16, 27, 23, 0.7), rgba(79, 129, 95, 0.5))',
  },
  {
    quote: 'I will walk you through it.',
    tagline: 'A calmer process',
    copy: 'A free financial readiness assessment: cash flow, protection gaps, existing coverage, and your next best move.',
    cta: 'Get free assessment',
    href: '/assessment',
    image: '/images/hero-build.jpg',
    focal: '50% 18%',
    zoom: 'cover',
    tint: 'linear-gradient(135deg, rgba(24, 48, 40, 0.72), rgba(24, 48, 40, 0.46))',
  },
];

const quickLinks = [
  { label: 'Protect my family', icon: 'ti-heart-plus', href: '/blog/what-life-insurance-actually-is' },
  { label: 'Understand my policy', icon: 'ti-shield-plus', href: '/resources/life-insurance-review-guide' },
  { label: 'Build my wealth', icon: 'ti-chart-histogram', href: '/blog/money-didnt-change-me' },
  { label: 'Check my readiness', icon: 'ti-clipboard-check', href: '/resources/financial-readiness-checklist' },
  { label: 'Explore a career', icon: 'ti-users-group', href: '/join-the-team' },
];

const helpTabs = [
  {
    id: 'existing',
    label: 'Existing clients',
    cards: [
      { title: 'Review my policy', copy: 'Check what your coverage includes before renewing or adding anything.', href: '/resources/life-insurance-review-guide' },
      { title: 'Understand my VUL', copy: 'Charges, fund value, and benefits explained without the jargon.', href: '/resources/vul-clarity-sheet' },
      { title: 'Talk with Venus', copy: 'Bring a question and get a calm, unhurried answer.', href: '/assessment' },
      { title: 'Download free guides', copy: 'Worksheets for readiness, coverage, and money conversations.', href: '/resources' },
    ],
  },
  {
    id: 'new',
    label: 'New here',
    cards: [
      { title: 'Start with your question', copy: 'Pick the pathway that sounds most like your life right now.', href: '/start-here' },
      { title: 'Get a free assessment', copy: 'A structured look at cash flow, protection, and next steps.', href: '/assessment' },
      { title: 'Read the articles', copy: 'Practical notes on money mindset, wealth, and intentional living.', href: '/blog' },
      { title: 'Join the team', copy: 'Explore a financial services career built on service and mentorship.', href: '/join-the-team' },
    ],
  },
];
---

<Base
  title="Intentional Thrive — Financial Clarity for Filipino Professionals"
  description="A modern financial clarity space for Filipino professionals who want to protect what matters and build with intention."
>

  <section class="hero-slider" data-hero aria-roledescription="carousel" aria-label="Intentional Thrive highlights">
    {heroSlides.map((slide, index) => (
      <article
        class:list={['hero-slide', index === 0 && 'is-active']}
        data-hero-slide
        aria-hidden={index === 0 ? 'false' : 'true'}
        style={`background-image: ${slide.tint}, url('${slide.image}'); background-position: ${slide.focal}; background-size: ${slide.zoom}`}
      >
        <div class="container--wide hero-slide__inner">
          <p class="hero-slide__quote">&ldquo;{slide.quote}&rdquo;</p>
          <p class="hero-slide__tagline">{slide.tagline}</p>
          <p class="hero-slide__copy">{slide.copy}</p>
          <a href={slide.href} class="hero-slide__cta">{slide.cta}</a>
        </div>
      </article>
    ))}

    <div class="hero-slider__controls">
      <button type="button" data-hero-prev aria-label="Previous slide"><i class="ti ti-chevron-left" aria-hidden="true"></i></button>
      <button type="button" data-hero-next aria-label="Next slide"><i class="ti ti-chevron-right" aria-hidden="true"></i></button>
    </div>
  </section>

  <section class="quicklinks" aria-label="Quick links">
    <div class="container--wide quicklinks__inner">
      <div class="quicklinks__main">
        <p class="quicklinks__label">I am looking to&hellip;</p>
        <div class="quicklinks__track" data-quick-track>
          {quickLinks.map((link) => (
            <a href={link.href} class="quicklinks__item">
              <i class={`ti ${link.icon}`} aria-hidden="true"></i>
              <span>{link.label}</span>
            </a>
          ))}
        </div>
        <div class="quicklinks__controls">
          <button type="button" data-quick-prev aria-label="Scroll quick links left"><i class="ti ti-chevron-left" aria-hidden="true"></i></button>
          <button type="button" data-quick-next aria-label="Scroll quick links right"><i class="ti ti-chevron-right" aria-hidden="true"></i></button>
        </div>
      </div>

      <aside class="quicklinks__aside">
        <p>Need help with your policy?</p>
        <a href="/assessment"><i class="ti ti-send" aria-hidden="true"></i> Get in touch</a>
      </aside>
    </div>
  </section>

  <section class="help-tabs">
    <div class="container--wide">
      <h2 class="help-tabs__title">How can we <strong>help?</strong></h2>

      <div class="help-tabs__nav" role="tablist">
        {helpTabs.map((tab, index) => (
          <button
            type="button"
            role="tab"
            id={`tab-${tab.id}`}
            aria-controls={`panel-${tab.id}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            class:list={['help-tabs__tab', index === 0 && 'is-active']}
            data-tab={tab.id}
          >
            {tab.label}
          </button>
        ))}
      </div>

      {helpTabs.map((tab, index) => (
        <div
          class:list={['help-tabs__panel', index === 0 && 'is-active']}
          id={`panel-${tab.id}`}
          role="tabpanel"
          aria-labelledby={`tab-${tab.id}`}
          data-panel={tab.id}
          hidden={index !== 0}
        >
          {tab.cards.map((card) => (
            <a href={card.href} class="help-card">
              <h3>{card.title}</h3>
              <p>{card.copy}</p>
              <span>Learn more <i class="ti ti-arrow-right" aria-hidden="true"></i></span>
            </a>
          ))}
        </div>
      ))}
    </div>
  </section>

  <section class="proof-band">
    <div class="container--wide proof-grid">
      <div><strong>Since 2019</strong><span>Financial services experience</span></div>
      <div><strong>600+</strong><span>Policies under care</span></div>
      <div><strong>2023</strong><span>Unit manager</span></div>
      <div><strong>PH</strong><span>Built for Filipino professionals</span></div>
    </div>
  </section>

  <section class="pathway-section">
    <div class="container--wide">
      <div class="section-heading compact">
        <p class="eyebrow">Find Your Path</p>
        <h2>One brand, three useful doors.</h2>
        <p>Intentional Thrive is built to help people understand money, make better decisions, and see the kind of leadership Venus brings to financial services.</p>
        <ThrivePath variant="rule" />
      </div>

      <div class="door-grid">
        <a href="/start-here" class="door">
          <span class="door__label">For readers</span>
          <h3>Start with the question that sounds like your life.</h3>
          <p>Guided pathways for insurance clarity, money mindset, family conversations, and intentional living.</p>
          <span class="door__link">Find your pathway &rarr;</span>
        </a>
        <a href="/assessment" class="door">
          <span class="door__label">For clients</span>
          <h3>Get a free financial readiness assessment.</h3>
          <p>Review cash flow, protection gaps, existing coverage, and your next best move with a calmer process.</p>
          <span class="door__link">Book the assessment &rarr;</span>
        </a>
        <a href="/join-the-team" class="door">
          <span class="door__label">For future advisors</span>
          <h3>Explore a career built on service and clarity.</h3>
          <p>How Venus mentors, and whether financial services fits your goals, strengths, and life season.</p>
          <span class="door__link">See what it takes &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <section class="journey" id="clarity-map">
    <div class="container--wide">
      <div class="section-heading">
        <p class="eyebrow">The Core Journey</p>
        <h2>Understand, then decide, then build.</h2>
        <p>The first goal is not a product. It is seeing clearly what your financial life is already asking from you.</p>
        <ThrivePath variant="rule" />
      </div>

      <div class="journey__path"><ThrivePath variant="journey" /></div>

      <div class="journey-grid">
        <article>
          <span class="journey__step">Understand</span>
          <h3>See the money pattern</h3>
          <p>Where income goes, what keeps repeating, and why higher earnings can still feel tight.</p>
        </article>
        <article>
          <span class="journey__step">Decide</span>
          <h3>Close the protection gap</h3>
          <p>What happens if income stops, health changes, or your family needs support quickly.</p>
        </article>
        <article>
          <span class="journey__step">Build</span>
          <h3>Make the next move</h3>
          <p>A practical sequence for savings, coverage, investing, and long-term family goals.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="decision-section" id="career">
    <div class="container--wide decision-grid">
      <div class="decision-card primary">
        <p class="eyebrow">For Clients</p>
        <h2>Start with a free financial readiness assessment.</h2>
        <p>Get a calm review of your current situation: budget, family responsibilities, insurance, risk, and goals.</p>
        <a href="/assessment" class="btn btn--primary">Book the assessment</a>
      </div>
      <div class="decision-card dark">
        <p class="eyebrow">For Future Advisors</p>
        <h2>Explore a career built on service and clarity.</h2>
        <p>If you want meaningful work with income growth and mentorship, start a conversation with Venus.</p>
        <a href="/join-the-team" class="btn btn--dark">Join the team</a>
      </div>
    </div>
  </section>

  <section class="guide-section">
    <div class="container--wide guide-grid">
      <div>
        <p class="eyebrow">Your Guide</p>
        <h2>Venus helps make the financial conversation easier to understand.</h2>
      </div>
      <div class="guide-copy">
        <p>Venus is a Pru Life UK Unit Manager, mom, wife, and founder of Intentional Thrive. She created this space for professionals who want honest financial literacy, not overwhelming jargon.</p>
        <p>This site is her public authority hub: client education, career mentorship, practical resources, and a more human way to talk about money.</p>
        <a href="/about" class="text-link">More about Venus &rarr;</a>
      </div>
    </div>
  </section>

  <section class="article-strip">
    <div class="container--wide">
      <div class="section-heading compact">
        <p class="eyebrow">Start Reading</p>
        <h2>Practical notes for an intentional financial life.</h2>
        <p>Use the articles to understand the issue, then move into a resource or assessment when you are ready to apply it.</p>
        <ThrivePath variant="rule" />
      </div>
      <div class="article-grid">
        {recentArticles.map(article => (
          <a href={`/blog/${article.slug}`} class="article-card">
            <span>{article.data.pillar}</span>
            <h3>{article.data.title}</h3>
            <p>{article.data.description}</p>
          </a>
        ))}
      </div>
      <div class="btn-row btn-row--center article-strip-actions">
        <a href="/start-here" class="btn btn--primary">Read by pathway</a>
        <a href="/resources" class="btn btn--outline">Browse resources</a>
      </div>
    </div>
  </section>

  <section class="final-banner">
    <div class="final-banner__mark" aria-hidden="true"><ThrivePath variant="mark" /></div>
    <div class="container">
      <p class="eyebrow">Ready when you are</p>
      <h2>One clear conversation can change the next decision.</h2>
      <a href="/assessment" class="btn-white">Get Free Assessment</a>
    </div>
  </section>

</Base>

<script>
  // Hero carousel
  const hero = document.querySelector('[data-hero]');
  const slides = Array.from(document.querySelectorAll('[data-hero-slide]'));
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (hero && slides.length > 1) {
    let index = 0;
    let timer;

    const show = (next) => {
      index = (next + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        slide.classList.toggle('is-active', i === index);
        slide.setAttribute('aria-hidden', i === index ? 'false' : 'true');
      });
    };

    const start = () => {
      if (reduceMotion) return;
      stop();
      timer = window.setInterval(() => show(index + 1), 7000);
    };
    const stop = () => window.clearInterval(timer);

    document.querySelector('[data-hero-prev]')?.addEventListener('click', () => { show(index - 1); start(); });
    document.querySelector('[data-hero-next]')?.addEventListener('click', () => { show(index + 1); start(); });
    hero.addEventListener('mouseenter', stop);
    hero.addEventListener('mouseleave', start);
    start();
  }

  // Quick links horizontal scroll
  const track = document.querySelector('[data-quick-track]');
  if (track) {
    const step = () => Math.max(track.clientWidth * 0.6, 200);
    document.querySelector('[data-quick-prev]')?.addEventListener('click', () =>
      track.scrollBy({ left: -step(), behavior: 'smooth' })
    );
    document.querySelector('[data-quick-next]')?.addEventListener('click', () =>
      track.scrollBy({ left: step(), behavior: 'smooth' })
    );
  }

  // Help tabs
  const tabs = Array.from(document.querySelectorAll('[data-tab]'));
  const panels = Array.from(document.querySelectorAll('[data-panel]'));

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const id = tab.getAttribute('data-tab');
      tabs.forEach((other) => {
        const active = other === tab;
        other.classList.toggle('is-active', active);
        other.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      panels.forEach((panel) => {
        const active = panel.getAttribute('data-panel') === id;
        panel.classList.toggle('is-active', active);
        panel.hidden = !active;
      });
    });
  });
</script>

<style>
/* Hero carousel */
.hero-slider {
  display: grid;
  isolation: isolate;
  min-height: clamp(460px, 62vh, 660px);
  overflow: hidden;
  position: relative;
}

.hero-slide {
  align-items: end;
  background-repeat: no-repeat;
  color: #fff;
  display: grid;
  grid-area: 1 / 1;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.9s ease;
}

.hero-slide.is-active {
  opacity: 1;
  pointer-events: auto;
}

.hero-slide__inner {
  max-width: var(--max-width-wide);
  padding-bottom: 210px;
  text-align: center;
}

.hero-slide.is-active .hero-slide__inner > * {
  animation: heroReveal 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
}

.hero-slide.is-active .hero-slide__tagline { animation-delay: 0.1s; }
.hero-slide.is-active .hero-slide__copy { animation-delay: 0.2s; }
.hero-slide.is-active .hero-slide__cta { animation-delay: 0.3s; }

.hero-slide__quote {
  color: #fff;
  font-family: var(--font-sans);
  font-size: clamp(36px, 5.4vw, 68px);
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.06;
  margin: 0 auto;
  max-width: 900px;
}

.hero-slide__tagline {
  color: rgba(255, 255, 255, 0.92);
  font-size: clamp(18px, 2.4vw, 26px);
  font-weight: 600;
  margin: 18px 0 0;
}

.hero-slide__copy {
  color: rgba(255, 255, 255, 0.82);
  font-size: 17px;
  line-height: 1.7;
  margin: 16px auto 0;
  max-width: 620px;
}

.hero-slide__cta {
  background: var(--color-accent);
  border-radius: var(--radius);
  color: #fff;
  display: inline-block;
  font-size: 15px;
  font-weight: 600;
  margin-top: 28px;
  padding: 15px 34px;
  transition: background 0.35s ease;
}

.hero-slide__cta:hover {
  background: #3f6f50;
  color: #fff;
}

.hero-slider__controls {
  bottom: 130px;
  display: flex;
  gap: 12px;
  justify-content: center;
  left: 0;
  position: absolute;
  right: 0;
  z-index: 4;
}

.hero-slider__controls button {
  align-items: center;
  background: rgba(255, 255, 255, 0.14);
  border: 1px solid rgba(255, 255, 255, 0.7);
  border-radius: 999px;
  color: #fff;
  cursor: pointer;
  display: inline-flex;
  font-size: 18px;
  height: 42px;
  justify-content: center;
  transition: background 0.2s ease, color 0.2s ease;
  width: 42px;
}

.hero-slider__controls button:hover {
  background: #fff;
  color: var(--color-dark);
}

/* Quick links bar (overlaps the hero) */
.quicklinks {
  margin-top: -84px;
  position: relative;
  z-index: 5;
}

.quicklinks__inner {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 300px;
  min-width: 0;
}

.quicklinks__main {
  align-items: center;
  background: var(--color-accent);
  border-radius: var(--radius-lg) 0 0 var(--radius-lg);
  color: #fff;
  display: flex;
  gap: 20px;
  min-width: 0;
  padding: 26px;
}

.quicklinks__label {
  color: #fff;
  flex-shrink: 0;
  font-size: 20px;
  font-weight: 800;
  letter-spacing: -0.02em;
  margin: 0;
  max-width: 150px;
}

.quicklinks__track {
  display: flex;
  flex: 1;
  gap: 14px;
  min-width: 0;
  overflow-x: auto;
  scroll-behavior: smooth;
  scrollbar-width: none;
}

.quicklinks__track::-webkit-scrollbar {
  display: none;
}

.quicklinks__item {
  color: #fff;
  display: grid;
  flex: 0 0 auto;
  font-size: 13px;
  font-weight: 600;
  gap: 8px;
  justify-items: center;
  line-height: 1.3;
  text-align: center;
  transition: opacity 0.35s ease;
  width: 96px;
}

.quicklinks__item i {
  font-size: 30px;
}

.quicklinks__item:hover {
  color: #fff;
  opacity: 0.78;
}

.quicklinks__controls {
  display: flex;
  flex-shrink: 0;
  gap: 10px;
}

.quicklinks__controls button {
  align-items: center;
  background: rgba(255, 255, 255, 0.22);
  border: none;
  border-radius: 999px;
  color: #fff;
  cursor: pointer;
  display: inline-flex;
  font-size: 18px;
  height: 40px;
  justify-content: center;
  transition: background 0.2s ease, color 0.2s ease;
  width: 40px;
}

.quicklinks__controls button:hover {
  background: #fff;
  color: var(--color-accent);
}

.quicklinks__aside {
  background: var(--color-dark);
  border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
  color: #fff;
  display: grid;
  align-content: center;
  gap: 14px;
  padding: 26px 30px;
}

.quicklinks__aside p {
  color: #fff;
  font-size: 16px;
  font-weight: 700;
  margin: 0;
}

.quicklinks__aside a {
  align-items: center;
  background: var(--color-accent-pale);
  border-radius: var(--radius);
  color: var(--color-dark);
  display: inline-flex;
  font-size: 14px;
  font-weight: 600;
  gap: 8px;
  justify-content: center;
  padding: 13px 20px;
  transition: background 0.2s ease, color 0.2s ease;
}

.quicklinks__aside a:hover {
  background: #fff;
  color: var(--color-accent);
}

/* How can we help — tabs */
.help-tabs {
  background: #fff;
  padding: 76px 0 88px;
}

.help-tabs__title {
  font-size: clamp(30px, 4vw, 46px);
  font-weight: 300;
  letter-spacing: -0.025em;
  margin-bottom: 26px;
}

.help-tabs__title strong {
  font-weight: 700;
}

.help-tabs__nav {
  border-bottom: 1px solid var(--color-border);
  display: flex;
  gap: 30px;
  margin-bottom: 34px;
}

.help-tabs__tab {
  background: none;
  border: none;
  border-bottom: 3px solid transparent;
  color: var(--color-text-muted);
  cursor: pointer;
  font-family: var(--font-sans);
  font-size: 16px;
  font-weight: 600;
  margin-bottom: -1px;
  padding: 0 2px 14px;
  transition: color 0.35s ease, border-color 0.35s ease;
}

.help-tabs__tab.is-active {
  border-bottom-color: var(--color-accent);
  color: var(--color-accent);
}

.help-tabs__panel {
  display: none;
  gap: 40px;
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.help-tabs__panel.is-active {
  display: grid;
}

.help-card {
  border-top: 1px solid var(--color-border);
  color: inherit;
  display: flex;
  flex-direction: column;
  padding-top: 22px;
  transition: border-color 0.35s ease;
}

.help-card:hover {
  border-top-color: var(--color-accent);
  color: inherit;
}

.help-card h3 {
  font-size: 20px;
  font-weight: 700;
  letter-spacing: -0.02em;
  margin-bottom: 10px;
}

.help-card p {
  color: var(--color-text-muted);
  font-size: 14px;
  line-height: 1.65;
  margin-bottom: 16px;
}

.help-card span {
  color: var(--color-accent);
  font-size: 13px;
  font-weight: 600;
  margin-top: auto;
}

.proof-band {
  background: linear-gradient(180deg, #ffffff 0%, #f7faf8 100%);
  border-bottom: 1px solid var(--color-border);
  padding: 28px 0;
}

.proof-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

.proof-grid div {
  border-left: 3px solid rgba(214, 189, 120, 0.72);
  padding-left: 16px;
}

.proof-grid strong {
  color: var(--color-dark);
  display: block;
  font-size: 28px;
  font-weight: 700;
  letter-spacing: -0.025em;
}

.proof-grid span {
  color: var(--color-text-muted);
  font-size: 13px;
}

.journey,
.decision-section,
.guide-section,
.pathway-section,
.article-strip {
  padding: 104px 0;
}

.journey,
.guide-section {
  background: var(--color-bg);
}

